# Copy to backend/.env — these values work with `docker compose up -d` out of the box.

# Local PostGIS from docker-compose.yml (host port 5433; set OPENPARKS_DB_PORT to change it)
DATABASE_URL=postgresql://openparks:openparks@localhost:5433/openparks
# Set to true for hosted Postgres that requires SSL (e.g. Supabase)
DB_SSL=false

JWT_SECRET=change-me-in-production

# Mailpit catches all email locally — open http://localhost:8025 to read OTP codes
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="OpenParks <no-reply@openparks.local>"

# Comma-separated list of allowed frontend origins (blank = http://localhost:5173,http://localhost:5174)
CORS_ORIGINS=
PORT=3000
