generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @db.VarChar
  email         String         @unique @db.VarChar
  password      String         @db.VarChar
  Verified      Boolean?       @default(false)
  reviews       Review[]
  safetyReports SafetyReport[]
}

model Park {
  id                Int                      @id @default(autoincrement())
  name              String                   @db.VarChar
  mobility_data     String?                  @db.VarChar
  maintenance_stats String?                  @db.VarChar
  location          Unsupported("geography")
  osm_type          String?                  @db.VarChar(16)
  osm_id            BigInt?
  amenities         ParkAmenity[]
  reviews           Review[]
  SafetyReport      SafetyReport[]
  trails            trails[]

  @@unique([osm_type, osm_id])
  @@index([location], type: Gist)
}

model ParkAmenity {
  id       Int                      @id @default(autoincrement())
  park_id  Int
  name     String                   @db.VarChar
  location Unsupported("geometry")?
  osm_type String?                  @db.VarChar(16)
  osm_id   BigInt?
  park     Park                     @relation(fields: [park_id], references: [id])

  @@unique([osm_type, osm_id])
  @@index([location], type: Gist)
}

model SafetyReport {
  id          Int                      @id @default(autoincrement())
  user_id     Int
  description String                   @db.VarChar
  image       Bytes?
  status      ReportStatus             @default(OPEN)
  created_at  DateTime                 @default(now())
  location    Unsupported("geography(Point,4326)")
  heading     String?
  park_id     Int?
  Park        Park?                    @relation(fields: [park_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user        User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([location], type: Gist)
}
model Review {
  id         Int      @id @default(autoincrement())
  user_id    Int
  park_id    Int
  content    String   @db.VarChar
  rating     Int
  created_at DateTime @default(now())
  title      String?
  park       Park     @relation(fields: [park_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model trails {
  id      Int                      @id @default(autoincrement())
  park_id Int?
  osm_id  BigInt?
  highway String?                  @db.VarChar(50)
  name    String?                  @db.VarChar(255)
  surface String?                  @db.VarChar(50)
  geom    Unsupported("geometry")?
  Park    Park?                    @relation(fields: [park_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([park_id, osm_id])
  @@index([geom], type: Gist)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model OneTimePasswords {
  id         BigInt   @id(map: "One Time Passwords_pkey") @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  value      String?  @default("NULL")
  active     Boolean? @default(false)
  email      String?
}

enum ReportStatus {
  OPEN
  RESOLVED
  PENDING
}
